# Generate actual secrets with bash scripts/configure.sh; never use placeholder keys.
JWT_PRIVATE_SEED=
JWT_PUBLIC_KEY=
GATEWAY_SERVICE_TOKEN=
CHAT_SERVICE_TOKEN=
INDEXER_SERVICE_TOKEN=
RAG_SERVICE_TOKEN=
CORP_SERVICE_TOKEN=
POSTGRES_PASSWORD=
AUTH_DB_PASSWORD=
INFO_DB_PASSWORD=
CHAT_DB_PASSWORD=
APP_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
SEED_DEMO=true
# The internal mock is the default. Set RAG_URL to your ML service to integrate.
# RAG_URL=http://host.docker.internal:8000

# Google OAuth (Credentials -> OAuth client ID -> Web application).
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxx
# Должен ТОЧНО совпадать с одним из Authorized redirect URIs в консоли Google.
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback
# SOCKS5-прокси для исходящих запросов к Google; нужен только если в этой сети
# Google недоступен напрямую (иначе оставить закомментированным).
# HTTPS_PROXY=socks5://127.0.0.1:10809

# Отправка кода для входа на почту. Без SMTP_HOST письмо пишется в лог auth.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=robot@ai-buddy.ru
SMTP_PASSWORD=
SMTP_FROM=robot@ai-buddy.ru
