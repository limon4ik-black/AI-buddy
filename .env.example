# Скопируй в .env и подставь свои значения из Google Cloud Console
# (Credentials -> OAuth client ID -> Web application).
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxx
# Должен ТОЧНО совпадать с одним из Authorized redirect URIs в консоли Google.
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback

# Локальный SOCKS5-прокси (xray) для исходящих запросов сервера к Google:
# без него POST на oauth2.googleapis.com/v1/userinfo не доходит (таймаут).
HTTPS_PROXY=socks5://127.0.0.1:10808

# Redis для refresh-токенов (контейнер: docker compose up -d).
REDIS_ADDR=localhost:6379
