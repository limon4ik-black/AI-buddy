# Run make configure to generate real keys and passwords in .env.
JWT_PRIVATE_SEED=
JWT_PUBLIC_KEY=
GATEWAY_SERVICE_TOKEN=
CHAT_SERVICE_TOKEN=
INDEXER_SERVICE_TOKEN=
RAG_SERVICE_TOKEN=
CORP_SERVICE_TOKEN=
POSTGRES_PASSWORD=
AUTH_DB_PASSWORD=
INFO_DB_PASSWORD=
CHAT_DB_PASSWORD=
APP_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
SEED_DEMO=true
# Per-user limits for notes and boards.
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
# Mailpit is the local default. Override only for a real SMTP provider.
BUDDY_SMTP_HOST=mailpit
BUDDY_SMTP_PORT=1025
BUDDY_SMTP_USER=
BUDDY_SMTP_PASSWORD=
BUDDY_SMTP_FROM=buddy@demo.test
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback
# Required only for make rag / make ws.
GROQ_API_KEY=
# Optional local HTTP proxy for Groq/Hugging Face, e.g. http://host.docker.internal:10808
RAG_HTTPS_PROXY=
GROQ_MODEL=qwen/qwen3.8-27b
